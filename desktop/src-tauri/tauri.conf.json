{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReverseLab",
  "version": "2.0.0-beta.1",
  "identifier": "com.reverselab.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ReverseLab",
        "width": 1280,
        "height": 840,
        "decorations": false,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      },
      "endpoints": [
        "https://github.com/LING71671/open-reverselab/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDNjk4MEFCRTAwN0E0NkYKUldSdnBBZmdxNEJwM09tMlhoUSt4ZFlSN1MwaHdwWmlRUW5KQk9pNTRYL1Q3R2dVVGxDa2xjMm0K"
    }
  }
}
