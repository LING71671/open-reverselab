{
  "$id": "https://raw.githubusercontent.com/LING71671/open-reverselab/main/schemas/extension-registry.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "entries": {
      "items": {
        "oneOf": [
          {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "artifact"
                  ]
                },
                {
                  "required": [
                    "repository"
                  ]
                }
              ]
            },
            "required": [
              "path"
            ]
          },
          {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "path"
                  ]
                },
                {
                  "required": [
                    "repository"
                  ]
                }
              ]
            },
            "required": [
              "artifact",
              "sha256"
            ]
          },
          {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "path"
                  ]
                },
                {
                  "required": [
                    "artifact"
                  ]
                }
              ]
            },
            "required": [
              "repository"
            ]
          }
        ],
        "properties": {
          "artifact": {
            "pattern": "^https://",
            "type": "string"
          },
          "id": {
            "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$",
            "type": "string"
          },
          "kind": {
            "enum": [
              "knowledge",
              "mcp"
            ]
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "repository": {
            "pattern": "^https://github\\.com/",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "type": "string"
          },
          "version": {
            "$ref": "extension-manifest.schema.json#/$defs/version"
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "version"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "id": {
      "minLength": 1,
      "type": "string"
    },
    "protocol": {
      "const": "open-reverselab.registry/v1"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "protocol",
    "id",
    "title",
    "entries"
  ],
  "title": "Open ReverseLab extension registry v1",
  "type": "object"
}
